{
  "name": "kart-party",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Party Hub - Kart Party, Smash Party and Party Rush: couch-multiplayer party games. The game runs on a laptop/TV, phones are the controllers.",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && node dist-server/server.mjs",
    "start:https": "npm run build && node dist-server/server.mjs --https",
    "serve": "node dist-server/server.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "playwright test",
    "bots": "tsx scripts/bots.ts",
    "test:motion": "tsx scripts/motion-selftest.ts",
    "test:rush": "tsx scripts/rush-selftest.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^2.4.1",
    "three": "^0.185.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
